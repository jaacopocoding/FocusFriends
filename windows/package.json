{
  "name": "focusfriends-windows",
  "version": "0.0.0",
  "private": true,
  "description": "FocusFriends per Windows (Electron). In costruzione: per ora c'è solo la logica pura, in src/core.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
