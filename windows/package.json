{
  "name": "focusfriends-windows",
  "version": "1.1.1",
  "private": true,
  "description": "FocusFriends per Windows: un compagno sul desktop e un timer per studiare (Electron).",
  "author": "jaacopocoding",
  "license": "MIT",
  "homepage": "https://github.com/jaacopocoding/FocusFriends",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaacopocoding/FocusFriends.git",
    "directory": "windows"
  },
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit -p .",
    "build": "node tools/build.mjs",
    "start": "node tools/build.mjs && electron .",
    "risorse": "node tools/prepara-risorse.mjs",
    "pacchetto": "node tools/build.mjs && node tools/prepara-risorse.mjs && electron-builder --win"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-static": "1.59.0",
    "typescript": "7.0.2"
  }
}
