    "@fontsource/patrick-hand": "5.3.0",
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.59.0",
    "typescript": "7.0.2"
  },
  "main": "dist/main/main.cjs"
}
